# Copia esto a .env y rellena la clave.  cp .env.example .env
#
# Lo leen dos cosas distintas, y las dos por su cuenta:
#   - spring-dotenv, al arrancar la aplicacion fuera de Docker
#   - docker compose, para rellenar las variables de docker-compose.yml
#
# El .env de verdad esta en .gitignore. Este ejemplo no, y por eso no lleva valores.

# Clave de OpenRouter, de https://openrouter.ai/keys. Sin ella la aplicacion no arranca.
API_KEY=

# Opcionales: si no estan, mandan los valores de application.yaml.
# DB_PASSWORD=
# JWT_SECRET=
